-- SNAPNOTES BEGIN
-- Merge this into ~/.hammerspoon/init.lua (create the file if it doesn't exist yet).
-- Hotkeys (neither collides with system shortcuts like cmd+shift+3/4/5):
--   cmd+shift+7 -> full-screen capture
--   cmd+shift+8 -> crop/interactive capture (click-drag to select an area)

local inboxDir = os.getenv("HOME") .. "/snapnotes/inbox/"

local function ensureSnapNotesRunning()
    -- launchctl kickstart (no -k) is a no-op if already running, starts it
    -- fresh if not - safe to call on every capture, self-heals after a
    -- manual Quit from the menu bar without disrupting an active run.
    -- Resolves the user via `whoami` inside the shell itself rather than
    -- Lua's os.getenv("USER"), which isn't reliably set for GUI apps.
    hs.execute("launchctl kickstart gui/$(id -u)/com.$(whoami).snapnotes")
end

local function captureTo(flags)
    ensureSnapNotesRunning()
    local filename = inboxDir .. "snap_" .. os.date("%Y%m%d_%H%M%S") .. "_" .. tostring(math.random(1000, 9999)) .. ".png"
    local args = {}
    for _, f in ipairs(flags) do table.insert(args, f) end
    table.insert(args, filename)
    hs.task.new("/usr/sbin/screencapture", function(exitCode)
        if exitCode == 0 then
            hs.alert.show("SnapNotes: captured")
        end
    end, args):start()
end

hs.hotkey.bind({"cmd", "shift"}, "7", function()
    captureTo({})
end)

hs.hotkey.bind({"cmd", "shift"}, "8", function()
    captureTo({"-i"})
end)
-- SNAPNOTES END
